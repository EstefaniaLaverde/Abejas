{
  "name": "abejas",
  "private": true,
  "version": "0.1.0",
  "description": "Abejas: juego de cartas colombiano, online, para jugar con amigos.",
  "workspaces": [
    "abejas-game",
    "abejas-server",
    "abejas-web"
  ],
  "scripts": {
    "dev": "bash dev.sh",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w abejas-server",
    "dev:web": "npm run dev -w abejas-web"
  }
}
